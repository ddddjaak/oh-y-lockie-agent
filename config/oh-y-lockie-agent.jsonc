{
  "$schema": "https://opencode.ai/config.json",

  // =========================================================================
  // oh-y-lockie-agent 配置
  // =========================================================================
  // 本文件只保留「用户可调项」：每个 agent 的 model 覆盖、以及 disable 开关。
  //
  // 【注意】agent 的定义（prompt / 描述 / mode / color）已收归代码
  //        src/agents/definitions.ts，不在本文件维护。这里只改 model / disable。
  //
  // 【模型解析】agent 的 model 默认留空——插件启动时自动探测 opencode.json
  // 里配置的 provider，把每个 agent 解析到实际可用的模型（override >
  // 定义默认模型 > 同名模型 > 任一可用模型）。你只需在下面填入想覆盖的
  // agent，例如把 architect 换成你的主模型：
  //     "architect": { "model": "my-provider/my-model" }
  //
  // 【配置层级】（优先级从高到低）:
  //   1. 项目级:  .opencode/oh-y-lockie-agent.jsonc
  //   2. 用户级:  ~/.config/opencode/oh-y-lockie-agent.jsonc
  //   3. 插件默认: config/oh-y-lockie-agent.jsonc（本文件）
  // =========================================================================

  "agent": {

    // ── 主 Agent ──────────────────────────────────────────────────

    "architect": {
      // "model": "my-provider/my-model"
    },

    "firmware": {
      // "model": "my-provider/my-model"
    },

    // ── Subagent: 设计类 ─────────────────────────────────────────

    "power-architect": {
      // "model": "my-provider/my-pro-model"
    },

    "boot-bringup-specialist": {
      // "model": "my-provider/my-pro-model"
    },

    "memory-map-specialist": {
      // "model": "my-provider/my-pro-model"
    },

    "firmware-architect": {
      // "model": "my-provider/my-model"
    },

    "timing-analyst": {
      // "model": "my-provider/my-pro-model"
    },

    "register-map-generator": {
      // "model": "my-provider/my-model"
    },

    // ── Subagent: 审查类 ─────────────────────────────────────────

    "code-reviewer": {
      // "model": "my-provider/my-pro-model"
    },

    "security-auditor": {
      // "model": "my-provider/my-pro-model"
    },

    "system-architect": {
      // "model": "my-provider/my-pro-model"
    },

    // ── Subagent: 领域专家 ───────────────────────────────────────

    "fw-domain-expert": {
      // "model": "my-provider/my-model"
    },

    "hw-domain-expert": {
      // "model": "my-provider/my-model"
    },

    "compliance-reviewer": {
      // "model": "my-provider/my-model"
    },

    // ── Subagent: 质量保障 ───────────────────────────────────────

    "test-engineer": {
      // "model": "my-provider/my-model"
    },

    "verification-engineer": {
      // "model": "my-provider/my-model"
    },

    // ── 禁用默认 agent ───────────────────────────────────────────

    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },

  // ── MCP 服务器配置 ─────────────────────────────────────────────
  // 以下为推荐的 MCP 服务，插件会自动注入到 opencode 运行时的 mcp 配置中。
  // 如果你已在 opencode.json 中配置了同名 MCP 服务器，插件不会覆盖。

  "mcp": {
    "codegraph": {
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "type": "local"
    },
    "memory": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "type": "local"
    },
    "sequential-thinking": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "type": "local"
    }
  }

  // ── 嵌入式目标上下文（可选，预留）──────────────────────────────
  // 填写后所有 agent 可据此给芯片特定建议（而非泛泛而谈）。
  // 例：用户问"配置 PLL"，AI 知道是 STM32F4 还是 nRF52，给对应寄存器位定义。
  // 不填则给通用建议。优先级：project 级 > user 级 > 本默认。
  //
  // "target": {
  //   "chip": "CS32F103C8T6",     // Chipsea 芯片型号
  //   "family": "Cortex-M3",      // 架构家族：Cortex-M0/M3/M4/M7/M33, RISC-V
  //   "sdk": "Chipsea SDK",       // SDK：Chipsea SDK / Zephyr
  //   "toolchain": "GCC ARM"      // 工具链：GCC ARM / Keil / IAR
  // }
}
