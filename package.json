{
  "name": "oh-y-lockie-agent",
  "version": "1.1.0",
  "description": "芯片系统架构师 + 嵌入式工程师双管线智能编排插件 — OpenCode即插即用。含2主Agent+14Subagent+62Skill(55 opencode + 7 agents)。自然语言触发，无需 slash 命令。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "references",
    "config/oh-y-lockie-agent.jsonc",
    "config/mcp-servers.json",
    ".mcp.json",
    "AGENTS.md",
    "scripts/postinstall.mjs",
    "scripts/preuninstall.mjs",
    "scripts/setup-mcp.mjs",
    "scripts/analyze-telemetry.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "telemetry": "node scripts/analyze-telemetry.mjs",
    "setup-mcp": "node scripts/setup-mcp.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "chip",
    "embedded",
    "se",
    "ae"
  ],
  "author": "y-lockie",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.0",
    "@opencode-ai/sdk": "^1.18.9",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.8",
    "vitest": "^4.1.10"
  }
}
